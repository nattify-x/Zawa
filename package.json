{
  "name": "zawa",
  "displayName": "Zawa",
  "description": "Offline security scanner that guards your code before it leaves your machine.",
  "version": "0.1.1",
  "publisher": "nattify-x",
  "repository": {
    "type": "git",
    "url": "https://github.com/nattify-x/Zawa"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "main": "./out/extension/extension.js",
  "icon": "media/icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "zawa.scanWorkspace",
        "title": "Zawa: Scan Workspace",
        "category": "Zawa"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "scan": "node out/cli/zawa-cli.js",
    "bench:generate": "node benchmark/generate.js",
    "bench:eval": "node benchmark/evaluate.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
